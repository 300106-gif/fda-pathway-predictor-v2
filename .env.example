# FDA Pathway Predictor — Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to GitHub — it's in .gitignore

# LLM API Key (needed for CrewAI agent mode, not needed for direct mode)
# Use ONE of the following:
OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# openFDA API Key (optional — API works without key, but rate limits are higher with one)
# Get a free key at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Pipeline settings
PIPELINE_MODE=direct
# Options: "direct" (no LLM, runs tools sequentially) or "crewai" (uses LLM agents)

# Data settings
DATA_START_YEAR=2015
DATA_END_YEAR=2025
